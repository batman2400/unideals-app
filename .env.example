# Uni Deals mobile app environment
#
# These are the same Supabase project credentials the web app reads as
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY. Expo only exposes variables
# prefixed with EXPO_PUBLIC_ to the client bundle, so copy the values across:
#
#   web .env.local            ->  mobile .env
#   VITE_SUPABASE_URL         ->  EXPO_PUBLIC_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY    ->  EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# Copy this file to `.env` and fill in the values.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
